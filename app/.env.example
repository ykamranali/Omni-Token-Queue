# Copy this file to .env and adjust for your site.

# Port the server listens on
PORT=3000

# Path to the SQLite database file (created automatically on first run)
DB_PATH=./data/omni_token_queue.sqlite

# Session cookie secret - set this to a long random string in production
SESSION_SECRET=change-this-to-a-long-random-string

# Default admin account created on first run (only used if the database is empty)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_COMPANY_NAME=My Organization
